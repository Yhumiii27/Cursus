{
  "name": "cursus",
  "version": "0.1.0",
  "private": true,
  "description": "Cursus — suivi des formations, habilitations, temps, congés, entretiens et déplacements",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "reset-demo": "node server/src/reset.ts",
    "backup": "node --disable-warning=ExperimentalWarning server/src/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning server/src/restore.ts",
    "comptes": "node --disable-warning=ExperimentalWarning server/src/comptes-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/verifier-await.mjs",
    "check:await": "node scripts/verifier-await.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"client/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=99 --test-coverage-branches=90 --test-coverage-functions=96 \"tests/**/*.test.ts\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "mesure": "node --disable-warning=ExperimentalWarning scripts/mesure-instantane.ts",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "app": "bash desktop/build-app.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
