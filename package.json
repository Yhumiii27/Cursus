{
  "name": "cursus",
  "version": "0.1.0",
  "private": true,
  "description": "Cursus — suivi des formations, habilitations, temps, congés, entretiens et déplacements",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/src/index.ts",
    "reset-demo": "node server/src/reset.ts",
    "backup": "node --disable-warning=ExperimentalWarning server/src/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning server/src/restore.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "app": "bash desktop/build-app.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
